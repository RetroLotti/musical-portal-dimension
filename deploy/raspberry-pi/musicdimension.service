[Unit]
Description=Music Dimension NFC music player
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=musicdimension
Group=musicdimension
SupplementaryGroups=plugdev audio
WorkingDirectory=/opt/musicdimension
Environment=HOME=/var/lib/musicdimension
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/cache/musicdimension
Environment=MUSICDIMENSION_AUDIO_OUTPUT=alsa
Environment=MUSICDIMENSION_WEB_URL=http://0.0.0.0:5080
ExecStart=/opt/musicdimension/MusicDimension
Restart=on-failure
RestartSec=5
StateDirectory=musicdimension
CacheDirectory=musicdimension
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/musicdimension/config /opt/musicdimension/media

[Install]
WantedBy=multi-user.target