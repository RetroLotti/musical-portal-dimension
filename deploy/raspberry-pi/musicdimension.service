[Unit]
Description=Music Dimension NFC music player
Wants=network-online.target musicdimension-audio.service
After=network-online.target sound.target musicdimension-audio.service

[Service]
Type=simple
User=musicdimension
Group=musicdimension
SupplementaryGroups=plugdev audio
WorkingDirectory=/opt/musicdimension
Environment=HOME=/var/lib/musicdimension
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/cache/musicdimension
Environment=PULSE_SERVER=unix:/run/musicdimension-audio/native
Environment=MUSICDIMENSION_AUDIO_OUTPUT=pulse
Environment=MUSICDIMENSION_WEB_URL=http://0.0.0.0:5080
ExecStartPre=+/usr/bin/python3 -I /usr/local/lib/musicdimension/update-soloist.py --startup
ExecStart=/opt/musicdimension/MusicDimension
Restart=on-failure
RestartSec=5
StateDirectory=musicdimension
CacheDirectory=musicdimension
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/opt/musicdimension/config /opt/musicdimension/media /opt/musicdimension-soloist /var/lib/musicdimension-receiver
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target